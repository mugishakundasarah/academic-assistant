# Copy to backend/.env (ignored by git) for local development. Real environment
# variables take precedence over values in this file.

# Try the app with bundled fixture data and no Canvas account. When enabled,
# demo mode overrides any live credentials below: sync never contacts Canvas.
# CANVAS_DEMO=1

# Live Canvas (only with an institution-authorized token). Use the HTTPS origin only.
# CANVAS_BASE_URL=https://canvas.your-school.edu
# CANVAS_API_TOKEN=

# Optional: where the local SQLite database lives (relative to backend/).
# SQLITE_PATH=instance/academic.sqlite3

# Ed Discussion (undocumented API; read-only MCP server and CLI preview only).
# Create a token at https://edstem.org/us/settings/api-tokens and keep it here,
# never in MCP client config. ED_REGION is us, eu or au.
ED_API_TOKEN=
ED_REGION=us
